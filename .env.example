DATABASE_URL=
# 仅服务端使用；请勿使用 NEXT_PUBLIC_ 前缀，也不要提交真实值。
AMAP_WEB_SERVICE_KEY=
# 地图 JS API 的 Web 端 key（可公开）；在高德控制台限制为你的域名。
NEXT_PUBLIC_AMAP_JS_API_KEY=
# 2021-12-02 后创建的 JS key 还需要该安全密钥。
# 生产环境请改用代理模式，避免把 securityJsCode 下发到浏览器：
# 设置 NEXT_PUBLIC_AMAP_PROXY=true，并把安全密钥仅配置在服务端 AMAP_SECURITY_JS_CODE，
# 前端请求会经 /api/amap-proxy 统一代理转发（见 src/app/api/amap-proxy）。
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=
# AMAP_SECURITY_JS_CODE=
